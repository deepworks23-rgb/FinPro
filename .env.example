# Neon Postgres (pooled for app queries, unpooled/direct for schema migrations)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Session signing secret (64+ hex chars recommended)
SESSION_SECRET="replace-with-random-64-char-hex-secret"

# Neon Object Storage (S3-compatible)
S3_BUCKET="assets"
AWS_REGION="us-east-2"
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# GEMINI_API_KEY: Optional, for Gemini AI API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted
APP_URL="http://localhost:3000"
